{
  "name": "humanos",
  "version": "1.0.0",
  "description": "A web application for tracking habits and quests with monthly analytics.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "tsx --test src/ts/migration.test.ts src/ts/tasks.test.ts src/ts/goals.test.ts",
    "typecheck": "tsc --noEmit",
    "pages:deploy": "npm run build && wrangler pages deploy dist --project-name=quest-tracker",
    "pages:domain": "powershell -ExecutionPolicy Bypass -File scripts/setup-custom-domain.ps1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IshanWijekoon/humanOS.git"
  },
  "keywords": [
    "habits",
    "tracking",
    "productivity"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/IshanWijekoon/humanOS/issues"
  },
  "homepage": "https://github.com/IshanWijekoon/humanOS#readme",
  "devDependencies": {
    "autoprefixer": "^10.4.27",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "wrangler": "^4.107.1"
  }
}
